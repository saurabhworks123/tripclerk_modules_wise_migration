# ============================================================
# File Upload Configuration
# ============================================================
UPLOAD_FOLDER=./uploads
MAX_CONTENT_LENGTH=26214400
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx,xls,xlsx
UPLOAD_AGENDAS=./uploads/agendas
UPLOAD_REGISTRATIONS=./uploads/registrations
UPLOAD_RECEIPTS=./uploads/receipts
UPLOAD_CERTIFICATES=./uploads/certificates
UPLOAD_INSURANCE=./uploads/insurance

# ============================================================
# Security Configuration
# ============================================================
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_SPECIAL_CHAR=True
BCRYPT_LOG_ROUNDS=12
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME=43200

# JWT Configuration
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Rate Limiting
RATELIMIT_ENABLED=True
RATELIMIT_DEFAULT=100 per hour
RATELIMIT_STORAGE_URL=memory://

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# ============================================================
# Travel Policy Configuration
# ============================================================
ADVANCE_REQUEST_DAYS_MINIMUM=10
DEFAULT_PER_DIEM_ADVANCE_DAYS=10
POST_TRAVEL_REPORT_DEADLINE_DAYS=10
DEFAULT_REPORT_SUBMISSION_DAYS=10
CURRENT_MILEAGE_RATE=0.67
MONTHLY_RECONCILIATION_DEADLINE_DAY=25

# SLA Configuration (hours)
SLA_HR_REQUEST=2
SLA_TRAVEL_AUTHORIZATION=3
SLA_EXPENSE_REPORT=5

# Reminder Configuration
REMINDER_DAY_3=True
REMINDER_DAY_7=True
REMINDER_DAY_10=True

# ============================================================
# Feature Flags
# ============================================================
OCR_ENABLED=False
OCR_CONFIDENCE_THRESHOLD=0.8
RETENTION_YEARS=7
TENANCY_MODE=multi
ITEMS_PER_PAGE=25
BROWSER_NOTIFICATIONS_ENABLED=True
ANALYTICS_ENABLED=True
MAINTENANCE_MODE=False
MAINTENANCE_MESSAGE=System is under maintenance. Please try again later.

# ============================================================
# Logging Configuration
# ============================================================
LOG_LEVEL=DEBUG
LOG_FILE=logs/ntu_travel.log
SENTRY_DSN=

